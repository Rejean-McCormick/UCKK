{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uckk.math-university-projection/1.0.0",
  "title": "UCKK Math University Projection",
  "type": "object",
  "required": [
    "schema_version",
    "universe_id",
    "generated_from",
    "policy",
    "statistics",
    "pathways",
    "courses",
    "page_specs",
    "semantik_architect"
  ],
  "properties": {
    "schema_version": {"const": "MATH-UNIVERSITY-PROJECTION-1.0"},
    "universe_id": {"const": "math"},
    "generated_from": {
      "type": "object",
      "required": ["artifact", "release", "state_id", "referent_registry_id"],
      "properties": {
        "artifact": {"const": "mathkristal"},
        "release": {"type": "string", "minLength": 1},
        "state_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "referent_registry_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "policy": {"type": "object"},
    "statistics": {
      "type": "object",
      "required": ["projected_pathways", "projected_courses", "projected_page_specs"],
      "properties": {
        "projected_pathways": {"type": "integer", "minimum": 1},
        "projected_courses": {"type": "integer", "minimum": 1},
        "projected_page_specs": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "pathways": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pathway_id", "kristal_path_id", "course_ids", "referent_sequence"],
        "properties": {
          "pathway_id": {"type": "string", "pattern": "^math\\.path\\.[a-z0-9-]+$"},
          "kristal_path_id": {"type": "string", "minLength": 1},
          "course_ids": {"type": "array", "items": {"type": "string"}},
          "referent_sequence": {"type": "array", "items": {"type": "string", "pattern": "^urn:mathkristal:"}}
        },
        "additionalProperties": true
      }
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["math_course_id", "pathway_id", "kristal_ref", "page_spec_id"],
        "properties": {
          "math_course_id": {"type": "string", "pattern": "^MATH-[A-Z0-9]{3}-1[0-9]{2}$"},
          "kristal_ref": {"type": "string", "pattern": "^urn:mathkristal:"},
          "page_spec_id": {"type": "string", "pattern": "^math\\.page\\.[a-z0-9]+\\.1[0-9]{2}$"}
        },
        "additionalProperties": true
      }
    },
    "page_specs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page_spec_id", "math_course_id", "subject", "selection", "communication_obligations", "rendering"],
        "properties": {
          "subject": {
            "type": "object",
            "required": ["ref"],
            "properties": {
              "ref": {"type": "string", "pattern": "^urn:mathkristal:"}
            },
            "additionalProperties": true
          },
          "communication_obligations": {"type": "array", "minItems": 2},
          "rendering": {
            "type": "object",
            "required": ["content_selection_owner", "linguistic_realizer", "ai_runtime_required"],
            "properties": {
              "content_selection_owner": {"const": "UCKK Math University Projector"},
              "linguistic_realizer": {"const": "SemantiK Architect"},
              "ai_runtime_required": {"const": false}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "semantik_architect": {"type": "object"}
  },
  "additionalProperties": true
}
